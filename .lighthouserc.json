{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/marketplace",
        "http://localhost:3000/lp",
        "http://localhost:3000/governance"
      ],
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 40,
          "throughputKbps": 10240,
          "cpuSlowdownMultiplier": 1
        }
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "total-blocking-time": ["error", { "maxNumericValue": 100 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "interactive": ["error", { "maxNumericValue": 3800 }],
            "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
            "uses-text-compression": ["warn", { "minScore": 0.8 }],
            "render-blocking-resources": ["warn", { "maxLength": 2 }],
            "unused-javascript": ["warn", { "maxNumericValue": 204800 }],
            "total-byte-weight": ["error", { "maxNumericValue": 204800 }],
            "categories:performance": ["error", { "minScore": 0.7 }],
            "categories:best-practices": ["warn", { "minScore": 0.8 }],
            "categories:seo": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "aria-required-attr": ["error"],
            "aria-required-children": ["error"],
            "aria-required-parent": ["error"],
            "aria-roles": ["error"],
            "aria-valid-attr-role": ["error"],
            "aria-valid-attr": ["error"],
            "button-name": ["error"],
            "bypass": ["error"],
            "color-contrast": ["error"],
            "definition-list": ["error"],
            "dlitem": ["error"],
            "document-title": ["error"],
            "duplicate-id": ["error"],
            "frame-title": ["error"],
            "form-field-multiple-labels": ["error"],
            "html-has-lang": ["error"],
            "html-lang-valid": ["error"],
            "image-alt": ["error"],
            "input-button-name": ["error"],
            "input-image-alt": ["error"],
            "label": ["error"],
            "link-name": ["error"],
            "list": ["error"],
            "listitem": ["error"],
            "object-alt": ["error"],
            "page-has-heading-one": ["error"],
            "tabindex": ["error"],
            "td-headers-attr": ["error"],
            "th-has-data-cells": ["error"]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/marketplace$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.92 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/lp$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.90 }]
          }
        },
        {
          "matchingUrlPattern": "http://localhost:3000/governance$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.90 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
